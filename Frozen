<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Frozen the Musical at WWCC Promo</title>
    <style>
        :root {
            --ice-blue: #e0f7fa;
            --deep-navy: #0a192f;
            --glow-cyan: #00f2ff;
            --snow-white: #ffffff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--deep-navy);
            font-family: 'Montserrat', 'Segoe UI', Roboto, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
            position: relative;
        }

        /* Abstract Geometric Ice Background */
        body::before {
            content: '';
            position: absolute;
            width: 150%;
            height: 150%;
            background: linear-gradient(135deg, rgba(0, 242, 255, 0.05) 0%, transparent 50%, rgba(0, 242, 255, 0.02) 100%);
            clip-path: polygon(20% 0%, 80% 0%, 100% 20%, 100% 80%, 80% 100%, 20% 100%, 0% 80%, 0% 20%);
            animation: rotateBg 40s linear infinite;
            z-index: 1;
        }

        @keyframes rotateBg {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Poster Container optimized for a square social grid look */
        .promo-card {
            background: rgba(10, 25, 47, 0.85);
            border: 2px solid rgba(0, 242, 255, 0.3);
            box-shadow: 0 0 40px rgba(0, 242, 255, 0.15), inset 0 0 20px rgba(0, 242, 255, 0.05);
            width: 500px;
            height: 500px;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            z-index: 10;
            backdrop-filter: blur(10px);
        }

        /* Decorative Corner Brackets representing structural ice lines */
        .corner {
            position: absolute;
            width: 20px;
            height: 20px;
            border: 2px solid var(--glow-cyan);
        }
        .top-left { top: 15px; left: 15px; border-right: none; border-bottom: none; }
        .top-right { top: 15px; right: 15px; border-left: none; border-bottom: none; }
        .bottom-left { bottom: 15px; left: 15px; border-right: none; border-top: none; }
        .bottom-right { bottom: 15px; right: 15px; border-left: none; border-top: none; }

        .header {
            text-align: center;
        }

        .presenter {
            color: var(--glow-cyan);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .venue {
            color: var(--ice-blue);
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            opacity: 0.8;
        }

        /* High-Contrast Bold Typography Section */
        .lyric-title-box {
            margin: 20px 0;
            text-align: center;
        }

        .lyric-line {
            color: var(--snow-white);
            font-size: 2.8rem;
            font-weight: 900;
            text-transform: uppercase;
            line-height: 1.1;
            letter-spacing: -1px;
            text-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
        }

        .highlight {
            color: transparent;
            -webkit-text-stroke: 1px var(--glow-cyan);
            display: block;
            font-size: 3.2rem;
            margin-top: 5px;
        }

        .show-name {
            color: var(--ice-blue);
            font-size: 1.1rem;
            letter-spacing: 6px;
            text-transform: uppercase;
            margin-top: 15px;
            font-weight: 300;
            border-top: 1px solid rgba(0, 242, 255, 0.2);
            border-bottom: 1px solid rgba(0, 242, 255, 0.2);
            padding: 8px 0;
            display: inline-block;
            width: 100%;
        }

        /* Footer Details */
        .footer-details {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            border-top: 1px dashed rgba(224, 247, 250, 0.2);
            padding-top: 20px;
        }

        .info-block {
            display: flex;
            flex-direction: column;
        }

        .label {
            color: var(--glow-cyan);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 3px;
        }

        .value {
            color: var(--snow-white);
            font-size: 1.1rem;
            font-weight: 700;
        }

        .cta-btn {
            background: transparent;
            border: 1px solid var(--glow-cyan);
            color: var(--glow-cyan);
            padding: 10px 20px;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .cta-btn:hover {
            background: var(--glow-cyan);
            color: var(--deep-navy);
            box-shadow: 0 0 15px var(--glow-cyan);
        }
    </style>
</head>
<body>

    <div class="promo-card">
        <!-- Decorative Frame -->
        <div class="corner top-left"></div>
        <div class="corner top-right"></div>
        <div class="corner bottom-left"></div>
        <div class="corner bottom-right"></div>

        <!-- Header -->
        <div class="header">
            <p class="presenter">WWCC Theatre Department</p>
            <p class="venue">Rock Springs Campus</p>
        </div>

        <!-- Typography Centerpiece -->
        <div class="lyric-title-box">
            <h1 class="lyric-line">
                Let the storm <span class="highlight">RAGE ON</span>
            </h1>
            <h2 class="show-name">Frozen the Musical</h2>
        </div>

        <!-- Info/Action Bar -->
        <div class="footer-details">
            <div class="info-block">
                <span class="label">Opening Night</span>
                <span class="value">Coming Soon</span>
            </div>
            <button class="cta-btn" onclick="alert('Link to WWCC ticket office portfolio goes here!')">Get Tickets</button>
        </div>
    </div>

</body>
</html>
